{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Backend (Spring Boot)",
      "request": "launch",
      "mainClass": "com.example.demo.DemoApplication",
      "cwd": "${workspaceFolder}",
      "env": {
        "SPRING_PROFILES_ACTIVE": "dev"
      },
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Tomcat started on port(?:\\(s\\))?: (\\d+)",
        "uriFormat": "http://localhost:%s",
        "action": "startDebugging",
        "name": "Launch Integrated Browser"
      }
    },
    {
      "type": "editor-browser",
      "name": "Launch Integrated Browser",
      "request": "launch",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "msedge",
      "name": "Edge: Debug Frontend",
      "request": "launch",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}/src/main/resources/static"
    }
  ],
  "compounds": [
    {
      "name": "App + Integrated Browser",
      "configurations": [
        "Backend (Spring Boot)"
      ],
      "stopAll": true
    }
  ]
}
